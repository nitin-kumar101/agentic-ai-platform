# Groq API key for the routing agent
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=meta-llama/llama-prompt-guard-2-22m

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# MCP server (Streamable HTTP) — run separately with: python run_mcp.py
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# RAG / vector store: chroma (default) or postgres
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=rag/chroma_data
OPENAI_API_KEY=sk-your-key-here
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Only required when VECTOR_STORE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_platform